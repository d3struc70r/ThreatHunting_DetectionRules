DeviceProcessEvents
| where Timestamp > ago(TimeRange)
| where isnotempty(FileName)
| where ProcessCommandLine !has "QuickAssist.exe"
| extend FileNameLower = tolower(FileName)
| join kind=inner (RMM_Map | extend FileNameLower = tolower(ProcessName) | project-away ProcessName) on FileNameLower
| where not(FileNameLower == "code.exe" and ProcessCommandLine !contains "tunnel")
| where FileNameLower !in~ (ApprovedTools)
| extend
    PortableExec = iff(
        FolderPath !startswith @"C:\Program Files" and
        FolderPath !startswith @"C:\Program Files (x86)" and
        FolderPath !startswith @"C:\Windows",
        "YES (suspicious)", "no"),
    SignerStatus = strcat(
        tostring(InitiatingProcessSignatureStatus), " / ",
        tostring(InitiatingProcessSignerType))
| project
    Timestamp,
    DeviceId,
    ReportId,
    Tier,
    Application,
    ProcessName  = FileName,
    DeviceName,
    AccountUser  = strcat(AccountDomain, @"\", AccountName),
    FolderPath,
    PortableExec,
    SignerStatus,
    ProcessCommandLine,
    InitiatingProcessFileName,
    InitiatingProcessCommandLine,
    InitiatingProcessAccountName,
    SHA256
| sort by Tier asc, Timestamp desc
